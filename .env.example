# ============================================================
# DIGI NEWS NETWORK — Environment Variable Reference
# ============================================================
# Copy this file to server/.env and fill in real values.
# NEVER commit .env files with real credentials.
# All variables without defaults are REQUIRED in production.
# ============================================================

# ── Server ──────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Database ─────────────────────────────────────────────────
# MySQL connection string used by Prisma
DATABASE_URL="mysql://diginews:devpassword@localhost:3306/diginews_db"

# For Docker Compose
DB_ROOT_PASSWORD=rootpassword_change_in_prod
DB_NAME=diginews_db
DB_USER=diginews
DB_PASSWORD=devpassword_change_in_prod
DB_PORT=3306

# ── Authentication ────────────────────────────────────────────
# Use at least 64 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=CHANGE_THIS_to_a_64_char_random_secret_for_access_tokens
JWT_REFRESH_SECRET=CHANGE_THIS_to_a_different_64_char_secret_for_refresh_tokens
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# ── Storage ───────────────────────────────────────────────────
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./uploads
MAX_FILE_SIZE_MB=20

# For S3-compatible storage (production):
# STORAGE_DRIVER=s3
# AWS_BUCKET_NAME=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-south-1
# AWS_ENDPOINT_URL=          # for non-AWS S3-compatible services

# ── Email / SMTP ───────────────────────────────────────────────
# Required for password-reset and notification emails
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="DIGI NEWS NETWORK <no-reply@diginewsnetwork.com>"

# ── Frontend (Vite — must be prefixed with VITE_) ─────────────
# These are baked into the frontend bundle at build time.
VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_APP_NAME="DIGI NEWS NETWORK"
VITE_APP_TAGLINE="ದಿಗಿ ನ್ಯೂಸ್ ನೆಟ್‌ವರ್ಕ್"

