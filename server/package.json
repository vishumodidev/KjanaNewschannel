{
  "name": "@diginews/server",
  "version": "1.0.0",
  "description": "DIGI NEWS NETWORK — Express REST API",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --watch-path=src src/server.js",
    "start": "node src/server.js",
    "lint": "eslint src",
    "test": "node --test tests/**/*.test.js",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:seed": "node prisma/seed.js",
    "db:reset": "prisma migrate reset --force && node prisma/seed.js",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.0.1",
    "helmet": "^8.0.0",
    "express-rate-limit": "^7.5.0",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.23.8",
    "@diginews/shared": "*"
  },
  "devDependencies": {
    "prisma": "^6.1.0",
    "@prisma/client": "^6.1.0"
  }
}

