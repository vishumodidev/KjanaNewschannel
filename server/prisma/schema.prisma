generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  // Enable relation mode for PlanetScale / serverless MySQL (if needed):
  // relationMode = "prisma"
}

