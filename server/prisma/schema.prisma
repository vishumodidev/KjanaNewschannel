// ─────────────────────────────────────────────────────────────────────────────
// JANA NEWS NETWORK — Prisma Relational Database Schema
// MySQL 8 • UTF8MB4 • Relational Integrity • Strict Foreign Keys
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// 1. IDENTITY & ACCESS CONTROL (RBAC + SCOPES)
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id           BigInt    @id @default(autoincrement())
  email        String    @unique @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  displayName  String    @map("display_name") @db.VarChar(120)
  phone        String?   @db.VarChar(20)
  avatarUrl    String?   @map("avatar_url") @db.VarChar(512)
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // Relations
  employeeProfile   EmployeeProfile?
  userRoles         UserRole[]
  scopeAssignments  UserScopeAssignment[]
  refreshTokens     RefreshToken[]
  authoredArticles  Article[]             @relation("ArticleAuthor")
  editedArticles    Article[]             @relation("ArticleEditor")
  createdStories    Story[]               @relation("StoryCreator")
  assignedStories   StoryAssignment[]     @relation("StoryAssignee")
  givenAssignments  StoryAssignment[]     @relation("StoryAssigner")
  editorialComments EditorialComment[]
  uploadedMedia     MediaAsset[]
  versionChanges    ArticleVersion[]
  auditLogs         AuditLog[]
  comments          Comment[]
  bookmarks         ReaderBookmark[]
  notifications     Notification[]

  @@map("users")
}

model EmployeeProfile {
  id                BigInt    @id @default(autoincrement())
  userId            BigInt    @unique @map("user_id")
  staffId           String    @unique @map("staff_id") @db.VarChar(30)
  department        String    @db.VarChar(80)
  designation       String    @db.VarChar(100)
  primaryLanguageId Int       @map("primary_language_id")
  hireDate          DateTime? @map("hire_date") @db.Date
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  primaryLanguage Language @relation(fields: [primaryLanguageId], references: [id])

  @@map("employee_profiles")
}

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(60) // e.g. 'super_admin', 'district_reporter'
  displayName String   @map("display_name") @db.VarChar(120)
  description String?  @db.Text
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  userRoles        UserRole[]
  rolePermissions  RolePermission[]
  scopeAssignments UserScopeAssignment[]

  @@map("roles")
}

model Permission {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(80) // e.g. 'article:create', 'article:publish'
  module      String   @db.VarChar(60) // e.g. 'articles', 'editorial', 'users'
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId    BigInt   @map("user_id")
  roleId    Int      @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       Int      @map("role_id")
  permissionId Int      @map("permission_id")
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

enum ScopeType {
  GLOBAL
  STATE
  DISTRICT
  CATEGORY
  LANGUAGE
}

model UserScopeAssignment {
  id         BigInt    @id @default(autoincrement())
  userId     BigInt    @map("user_id")
  roleId     Int       @map("role_id")
  scopeType  ScopeType @map("scope_type")
  stateId    Int?      @map("state_id")
  districtId Int?      @map("district_id")
  categoryId Int?      @map("category_id")
  languageId Int?      @map("language_id")
  createdAt  DateTime  @default(now()) @map("created_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  state    State?    @relation(fields: [stateId], references: [id], onDelete: SetNull)
  district District? @relation(fields: [districtId], references: [id], onDelete: SetNull)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  language Language? @relation(fields: [languageId], references: [id], onDelete: SetNull)

  @@index([userId, scopeType])
  @@index([stateId])
  @@index([districtId])
  @@map("user_scope_assignments")
}

model RefreshToken {
  id         BigInt   @id @default(autoincrement())
  userId     BigInt   @map("user_id")
  tokenHash  String   @unique @map("token_hash") @db.VarChar(255)
  family     String   @db.VarChar(64)
  isRevoked  Boolean  @default(false) @map("is_revoked")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRevoked])
  @@map("refresh_tokens")
}

// ─────────────────────────────────────────────────────────────────────────────
// 2. GEOGRAPHY & TAXONOMY
// ─────────────────────────────────────────────────────────────────────────────

model Language {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(10) // 'kn', 'en', 'hi'
  nameNative  String   @map("name_native") @db.VarChar(60) // 'ಕನ್ನಡ'
  nameEnglish String   @map("name_english") @db.VarChar(60) // 'Kannada'
  direction   String   @default("ltr") @db.VarChar(10)
  isActive    Boolean  @default(true) @map("is_active")
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at")

  employeeProfiles EmployeeProfile[]
  scopeAssignments UserScopeAssignment[]
  stories          Story[]
  articles         Article[]

  @@map("languages")
}

model State {
  id        Int      @id @default(autoincrement())
  code      String   @unique @db.VarChar(10) // 'KA'
  nameEn    String   @map("name_en") @db.VarChar(100)
  nameKn    String   @map("name_kn") @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")

  districts        District[]
  stories          Story[]
  scopeAssignments UserScopeAssignment[]

  @@map("states")
}

model District {
  id        Int      @id @default(autoincrement())
  stateId   Int      @map("state_id")
  code      String   @db.VarChar(20) // 'KA_BLRU'
  nameEn    String   @map("name_en") @db.VarChar(100)
  nameKn    String   @map("name_kn") @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")

  state            State                 @relation(fields: [stateId], references: [id], onDelete: Cascade)
  stories          Story[]
  scopeAssignments UserScopeAssignment[]

  @@unique([stateId, code])
  @@map("districts")
}

model Category {
  id          Int      @id @default(autoincrement())
  slug        String   @unique @db.VarChar(80)
  nameEn      String   @map("name_en") @db.VarChar(100)
  nameKn      String   @map("name_kn") @db.VarChar(100)
  description String?  @db.Text
  icon        String?  @db.VarChar(50)
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  stories          Story[]
  scopeAssignments UserScopeAssignment[]

  @@map("categories")
}

model Tag {
  id        Int      @id @default(autoincrement())
  slug      String   @unique @db.VarChar(100)
  name      String   @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")

  articleTags ArticleTag[]

  @@map("tags")
}

// ─────────────────────────────────────────────────────────────────────────────
// 3. EDITORIAL & NEWS CONTENT
// ─────────────────────────────────────────────────────────────────────────────

enum StoryStatus {
  ACTIVE
  ARCHIVED
}

model Story {
  id                BigInt      @id @default(autoincrement())
  primaryLanguageId Int         @map("primary_language_id")
  categoryId        Int         @map("category_id")
  stateId           Int?        @map("state_id")
  districtId        Int?        @map("district_id")
  createdById       BigInt      @map("created_by_id")
  status            StoryStatus @default(ACTIVE)
  priority          Int         @default(0)
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  primaryLanguage Language          @relation(fields: [primaryLanguageId], references: [id])
  category        Category          @relation(fields: [categoryId], references: [id])
  state           State?            @relation(fields: [stateId], references: [id], onDelete: SetNull)
  district        District?         @relation(fields: [districtId], references: [id], onDelete: SetNull)
  createdBy       User              @relation("StoryCreator", fields: [createdById], references: [id])
  articles        Article[]
  assignments     StoryAssignment[]

  @@index([categoryId, status])
  @@index([stateId, districtId])
  @@map("stories")
}

enum ArticleStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  FACT_CHECK
  APPROVED
  SCHEDULED
  PUBLISHED
  CORRECTION
  RETRACTED
  TRANSLATION_ASSIGNED
  TRANSLATION_IN_PROGRESS
  TRANSLATION_SUBMITTED
  TRANSLATION_APPROVED
}

model Article {
  id              BigInt        @id @default(autoincrement())
  storyId         BigInt        @map("story_id")
  languageId      Int           @map("language_id")
  headline        String        @db.VarChar(500)
  slug            String        @db.VarChar(500)
  summary         String?       @db.Text
  body            String        @db.LongText
  status          ArticleStatus @default(DRAFT)
  authorId        BigInt        @map("author_id")
  editorId        BigInt?       @map("editor_id")
  featuredImageId BigInt?       @map("featured_image_id")
  isBreaking      Boolean       @default(false) @map("is_breaking")
  isFeatured      Boolean       @default(false) @map("is_featured")
  publishedAt     DateTime?     @map("published_at")
  scheduledAt     DateTime?     @map("scheduled_at")
  seoTitle        String?       @map("seo_title") @db.VarChar(255)
  seoDescription  String?       @map("seo_description") @db.VarChar(500)
  viewCount       BigInt        @default(0) @map("view_count")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  story             Story              @relation(fields: [storyId], references: [id], onDelete: Cascade)
  language          Language           @relation(fields: [languageId], references: [id])
  author            User               @relation("ArticleAuthor", fields: [authorId], references: [id])
  editor            User?              @relation("ArticleEditor", fields: [editorId], references: [id], onDelete: SetNull)
  featuredImage     MediaAsset?        @relation(fields: [featuredImageId], references: [id], onDelete: SetNull)
  versions          ArticleVersion[]
  articleTags       ArticleTag[]
  editorialComments EditorialComment[]
  comments          Comment[]
  bookmarks         ReaderBookmark[]

  @@unique([storyId, languageId]) // Exactly one article per language per story
  @@unique([languageId, slug]) // Language-scoped unique slug
  @@index([status, publishedAt])
  @@index([isBreaking, isFeatured])
  @@index([authorId])
  @@map("articles")
}

model ArticleVersion {
  id            BigInt   @id @default(autoincrement())
  articleId     BigInt   @map("article_id")
  versionNumber Int      @map("version_number")
  headline      String   @db.VarChar(500)
  summary       String?  @db.Text
  body          String   @db.LongText
  changedById   BigInt   @map("changed_by_id")
  changeReason  String?  @map("change_reason") @db.VarChar(255) // 'edit', 'correction', 'retraction'
  createdAt     DateTime @default(now()) @map("created_at")

  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  changedBy User    @relation(fields: [changedById], references: [id])

  @@unique([articleId, versionNumber])
  @@map("article_versions")
}

model ArticleTag {
  articleId BigInt @map("article_id")
  tagId     Int    @map("tag_id")

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@map("article_tags")
}

model StoryAssignment {
  id           BigInt    @id @default(autoincrement())
  storyId      BigInt    @map("story_id")
  assignedToId BigInt    @map("assigned_to_id")
  assignedById BigInt    @map("assigned_by_id")
  instructions String?   @db.Text
  dueDate      DateTime? @map("due_date")
  status       String    @default("PENDING") @db.VarChar(40) // 'PENDING', 'ACCEPTED', 'COMPLETED'
  createdAt    DateTime  @default(now()) @map("created_at")

  story      Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  assignedTo User  @relation("StoryAssignee", fields: [assignedToId], references: [id])
  assignedBy User  @relation("StoryAssigner", fields: [assignedById], references: [id])

  @@map("story_assignments")
}

model EditorialComment {
  id          BigInt   @id @default(autoincrement())
  articleId   BigInt   @map("article_id")
  authorId    BigInt   @map("author_id")
  body        String   @db.Text
  commentType String   @default("REVIEW_NOTE") @map("comment_type") @db.VarChar(50) // 'REVIEW_NOTE', 'FACT_CHECK', 'CORRECTION_REQUEST'
  createdAt   DateTime @default(now()) @map("created_at")

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id])

  @@map("editorial_comments")
}

// ─────────────────────────────────────────────────────────────────────────────
// 4. MEDIA & ASSETS
// ─────────────────────────────────────────────────────────────────────────────

model MediaAsset {
  id            BigInt   @id @default(autoincrement())
  filename      String   @db.VarChar(255)
  storageKey    String   @map("storage_key") @db.VarChar(512)
  storageDriver String   @default("local") @map("storage_driver") @db.VarChar(40) // 'local', 's3'
  mimeType      String   @map("mime_type") @db.VarChar(100)
  sizeBytes     BigInt   @map("size_bytes")
  width         Int?
  height        Int?
  altText       String?  @map("alt_text") @db.VarChar(300)
  caption       String?  @db.Text
  credit        String?  @db.VarChar(120)
  uploadedById  BigInt   @map("uploaded_by_id")
  createdAt     DateTime @default(now()) @map("created_at")

  uploadedBy User      @relation(fields: [uploadedById], references: [id])
  articles   Article[]

  @@map("media_assets")
}

// ─────────────────────────────────────────────────────────────────────────────
// 5. ADVERTISING & COMMERCIAL
// ─────────────────────────────────────────────────────────────────────────────

model Advertiser {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(150)
  contactName String?  @map("contact_name") @db.VarChar(120)
  email       String?  @db.VarChar(255)
  phone       String?  @db.VarChar(30)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  campaigns AdCampaign[]

  @@map("advertisers")
}

model AdCampaign {
  id           Int      @id @default(autoincrement())
  advertiserId Int      @map("advertiser_id")
  name         String   @db.VarChar(150)
  startDate    DateTime @map("start_date")
  endDate      DateTime @map("end_date")
  isActive     Boolean  @default(true) @map("is_active")
  budget       Decimal? @db.Decimal(12, 2)
  createdAt    DateTime @default(now()) @map("created_at")

  advertiser Advertiser    @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  placements AdPlacement[]

  @@map("ad_campaigns")
}

model AdPlacement {
  id         Int      @id @default(autoincrement())
  campaignId Int      @map("campaign_id")
  slotCode   String   @map("slot_code") @db.VarChar(60) // 'homepage_hero_side', 'article_inline', etc.
  targetUrl  String   @map("target_url") @db.VarChar(1024)
  imageUrl   String   @map("image_url") @db.VarChar(1024)
  headline   String?  @db.VarChar(255)
  ctaText    String?  @map("cta_text") @db.VarChar(60) // 'ಹೆಚ್ಚು ತಿಳಿದುಕೊಳ್ಳಿ →'
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")

  campaign AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([slotCode, isActive])
  @@map("ad_placements")
}

// ─────────────────────────────────────────────────────────────────────────────
// 6. GOVERNANCE, AUDIT & READER INTERACTION
// ─────────────────────────────────────────────────────────────────────────────

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  actorId    BigInt?  @map("actor_id")
  action     String   @db.VarChar(100) // e.g. 'article.publish', 'user.role_change'
  targetType String   @map("target_type") @db.VarChar(80) // 'Article', 'User'
  targetId   String?  @map("target_id") @db.VarChar(80)
  diffJson   String?  @map("diff_json") @db.LongText
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  userAgent  String?  @map("user_agent") @db.VarChar(512)
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([targetType, targetId])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model Notification {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  title     String   @db.VarChar(200)
  message   String   @db.Text
  linkUrl   String?  @map("link_url") @db.VarChar(512)
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

model ReaderBookmark {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  articleId BigInt   @map("article_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@map("reader_bookmarks")
}

model Comment {
  id        BigInt   @id @default(autoincrement())
  articleId BigInt   @map("article_id")
  userId    BigInt   @map("user_id")
  body      String   @db.Text
  isApproved Boolean  @default(false) @map("is_approved")
  createdAt DateTime @default(now()) @map("created_at")

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([articleId, isApproved])
  @@map("comments")
}
